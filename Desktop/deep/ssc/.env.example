# Resend (server-side only). Set these in the Vercel project environment,
# or in .env.local when running `vercel dev` locally.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: a verified sending domain, e.g.
# RESEND_FROM=AATCe Parul University <noreply@yourdomain.edu>
# Falls back to Resend's default sender if unset.
RESEND_FROM=AATCe Parul University <onboarding@resend.dev>
